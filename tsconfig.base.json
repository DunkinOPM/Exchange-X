{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "declaration": true,
    "sourceMap": true,

    "ignoreDeprecations": "6.0",

    "baseUrl": ".",

    "paths": {
      "@exchange/matching-engine": ["packages/matching-engine/src"],
      "@exchange/shared-events": ["packages/shared-events/src"]
    }
  }
}
